{
  "mode": "adapter",
  "environment": {
    "python": "3.10.12",
    "torch": "2.14.0+cu130",
    "torch_cuda": "13.0",
    "device_name": "NVIDIA GeForce GTX TITAN X",
    "compute_capability": "5.2",
    "adapter_loaded": true
  },
  "cases": [
    {
      "case": "mm 8x16 @ 16x32",
      "route": "llvm-sm52-mm-f32",
      "shape": [
        8,
        32
      ],
      "criterion": "float32 dot-product bound 2*n*u*(|A|@|B|)",
      "matches_cpu": true,
      "max_abs_error": 9.5367431640625e-07
    },
    {
      "case": "add bias 8x32",
      "route": "llvm-sm52-binary-f32",
      "shape": [
        8,
        32
      ],
      "criterion": "identical",
      "matches_cpu": true,
      "max_abs_error": 0.0
    },
    {
      "case": "relu 8x32",
      "route": "llvm-sm52-relu-f32",
      "shape": [
        8,
        32
      ],
      "criterion": "identical",
      "matches_cpu": true,
      "max_abs_error": 0.0
    },
    {
      "case": "mm 8x32 @ 32x8",
      "route": "llvm-sm52-mm-f32",
      "shape": [
        8,
        8
      ],
      "criterion": "float32 dot-product bound 2*n*u*(|A|@|B|)",
      "matches_cpu": true,
      "max_abs_error": 7.62939453125e-06
    },
    {
      "case": "softmax 8x8",
      "route": "llvm-sm52-softmax-f32",
      "shape": [
        8,
        8
      ],
      "criterion": "float32 softmax bound (n+2)*u*|softmax|",
      "matches_cpu": true,
      "max_abs_error": 2.9802322387695312e-08
    },
    {
      "case": "mm 1x257 @ 257x1",
      "route": "llvm-sm52-mm-f32",
      "shape": [
        1,
        1
      ],
      "criterion": "float32 dot-product bound 2*n*u*(|A|@|B|)",
      "matches_cpu": true,
      "max_abs_error": 0.0
    },
    {
      "case": "torch.ones on the GPU",
      "route": "llvm-sm52-fill-f32",
      "shape": [
        2,
        2
      ],
      "criterion": "identical",
      "matches_cpu": true,
      "max_abs_error": 0.0
    }
  ],
  "expected_outcome_observed": true
}
