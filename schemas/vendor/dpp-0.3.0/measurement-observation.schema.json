{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DPP Measurement Observation",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "observation_id",
    "entity_id",
    "claim_id",
    "representation_id",
    "surface_id",
    "observed_at",
    "mode",
    "retrieval_path",
    "finding_level",
    "verdict",
    "evidence",
    "limitations"
  ],
  "properties": {
    "observation_id": {
      "type": "string",
      "minLength": 1
    },
    "entity_id": {
      "type": "string"
    },
    "claim_id": {
      "type": "string"
    },
    "representation_id": {
      "type": "string"
    },
    "surface_id": {
      "type": "string"
    },
    "observed_at": {
      "type": "string",
      "format": "date-time"
    },
    "mode": {
      "enum": [
        "observation",
        "experiment",
        "optimization",
        "security"
      ]
    },
    "query_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "corpus_version": {
      "type": [
        "string",
        "null"
      ]
    },
    "model_provider": {
      "type": [
        "string",
        "null"
      ]
    },
    "model_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "model_version": {
      "type": [
        "string",
        "null"
      ]
    },
    "retrieval_path": {
      "enum": [
        "instrumented",
        "reported",
        "unknown"
      ]
    },
    "finding_level": {
      "enum": [
        "descriptive",
        "diagnostic",
        "causal"
      ]
    },
    "verdict": {
      "enum": [
        "SATISFIED",
        "VIOLATED",
        "GRAY",
        "NOT_APPLICABLE"
      ]
    },
    "metric": {
      "type": [
        "object",
        "null"
      ],
      "required": [
        "metric_id",
        "numerator",
        "denominator",
        "unit",
        "sampling_frame",
        "uncertainty_method"
      ],
      "properties": {
        "metric_id": {
          "type": "string"
        },
        "numerator": {
          "type": "integer",
          "minimum": 0
        },
        "denominator": {
          "type": "integer",
          "minimum": 0
        },
        "unit": {
          "type": "string"
        },
        "sampling_frame": {
          "type": "string"
        },
        "uncertainty_method": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "artifact_ref",
          "sha256",
          "evidence_grade"
        ],
        "properties": {
          "artifact_ref": {
            "type": "string"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "evidence_grade": {
            "enum": [
              "E0",
              "E1",
              "E2",
              "E3",
              "E4",
              "E5"
            ]
          }
        },
        "additionalProperties": false
      }
    },
    "rubric_version": {
      "type": [
        "string",
        "null"
      ]
    },
    "collector": {
      "type": [
        "string",
        "null"
      ]
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
